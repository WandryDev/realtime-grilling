{
  "name": "realtime-grilling",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    ".",
    "packages/*",
    "analytics/*"
  ],
  "scripts": {
    "build": "next build",
    "changeset": "changeset",
    "check": "ultracite check",
    "dev": "next dev",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium webkit",
    "eval": "cargo run -q --release --manifest-path src-tauri/Cargo.toml --example grill-eval --features eval --",
    "fix": "ultracite fix",
    "icons": "tauri icon src-tauri/app-icon.svg && rm -rf src-tauri/icons/android src-tauri/icons/ios src-tauri/icons/64x64.png",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "version": "changeset version && bun scripts/sync-version.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@grill/ui": "workspace:*",
    "@shadcn/react": "^0.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "effect": "4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@changesets/cli": "^3.0.3",
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "4.1.0",
    "@fission-ai/openspec": "1.15.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ultracite": "8.1.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.2"
}
