{
  "type": "object",
  "additionalProperties": false,
  "required": ["current_card_id", "ops"],
  "properties": {
    "current_card_id": { "type": ["string", "null"] },
    "ops": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "card_id", "field", "value", "evidence"],
            "properties": {
              "op": { "type": "string", "enum": ["update_card"] },
              "card_id": { "type": "string" },
              "field": { "type": "string", "enum": ["goal", "users", "scenarios", "edge_cases", "integrations", "constraints", "acceptance"] },
              "value": { "type": "string" },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "card_id", "title", "evidence"],
            "properties": {
              "op": { "type": "string", "enum": ["create_card"] },
              "card_id": { "type": "string" },
              "title": { "type": "string" },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "question_id", "answer", "evidence"],
            "properties": {
              "op": { "type": "string", "enum": ["mark_answered"] },
              "question_id": { "type": "string" },
              "answer": { "type": "string" },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["op", "card_id", "card_field", "gap_type", "priority", "text", "evidence"],
            "properties": {
              "op": { "type": "string", "enum": ["add_question"] },
              "card_id": { "type": "string" },
              "card_field": { "type": "string", "enum": ["goal", "users", "scenarios", "edge_cases", "integrations", "constraints", "acceptance"] },
              "gap_type": { "type": "string", "enum": ["empty", "assumption", "contradiction"] },
              "priority": { "type": "string", "enum": ["blocker", "important", "nice"] },
              "text": { "type": "string" },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "quote"],
        "properties": {
          "source_id": { "type": "string" },
          "quote": { "type": "string" }
        }
      }
    }
  }
}
