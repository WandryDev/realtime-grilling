{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "inputs": [
        { "step": "packages:mise" },
        { "local": true, "include": ["."] }
      ],
      "commands": ["bun install --frozen-lockfile --ignore-scripts"]
    },
    "build": {
      "commands": ["bun run --filter @grill/analytics-web build"]
    }
  },
  "deploy": {
    "startCommand": "bun analytics/server/src/main.ts",
    "variables": {
      "HOST": "0.0.0.0",
      "PORT": "8787",
      "WEB_DIR": "/app/analytics/web/out"
    }
  }
}
