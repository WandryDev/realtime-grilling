{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "realtime-grilling",
  "version": "../package.json",
  "identifier": "com.dev-wandry.realtime-grilling",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "/",
        "title": "Grill",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "visible": false
      },
      {
        "label": "onboarding",
        "url": "onboarding",
        "title": "Grill",
        "width": 960,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": false
      },
      {
        "label": "widget",
        "url": "widget",
        "title": "Grill",
        "width": 360,
        "height": 600,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false
      },
      {
        "label": "overlay",
        "url": "overlay",
        "title": "Grill",
        "width": 420,
        "height": 720,
        "contentProtected": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
