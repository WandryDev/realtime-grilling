{
  "title": "Brief",
  "description": "Project brief from the given materials only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "product",
    "stack",
    "modules",
    "glossary",
    "keyDocuments",
    "gaps"
  ],
  "properties": {
    "product": {
      "description": "What the product is and for whom, 1-3 sentences.",
      "type": "string"
    },
    "stack": {
      "description": "Technologies, services, integrations named in the materials.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "glossary": {
      "description": "Project terms and names, for speech recognition too.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "definition"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "definition": { "type": "string" }
        }
      }
    },
    "keyDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "title", "why"],
        "properties": {
          "sourceId": {
            "description": "A document id from the list: F1, F2...",
            "type": "string",
            "pattern": "^F[0-9]+$"
          },
          "title": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "gaps": {
      "description": "What the materials lack to estimate or build the product.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lens", "text"],
        "properties": {
          "lens": {
            "enum": [
              "goal",
              "users",
              "scenarios",
              "edgeCases",
              "integrations",
              "constraints",
              "acceptance"
            ]
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    }
  }
}
