{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating",
  "description": "Start widget and call overlay: read projects, people and calls; start and run a call; drag and hide; hand over to another window (windows_show); read whether another app uses the microphone (mic_activity_get); start, stop and watch the recording (recording_*). No project, people or settings changes.",
  "windows": ["widget", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "allow-projects-list",
    "allow-projects-get",
    "allow-people-list",
    "allow-people-get",
    "allow-calls-list",
    "allow-calls-get",
    "allow-calls-create",
    "allow-calls-update",
    "allow-call-participants-list",
    "allow-call-participants-add",
    "allow-call-participants-remove",
    "allow-topics-list",
    "allow-topics-get",
    "allow-task-cards-list",
    "allow-task-cards-get",
    "allow-questions-list",
    "allow-questions-get",
    "allow-questions-update",
    "allow-transcript-list",
    "allow-settings-get",
    "allow-windows-show",
    "allow-mic-activity-get",
    "allow-recording-start",
    "allow-recording-stop",
    "allow-recording-status"
  ]
}
