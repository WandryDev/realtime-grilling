{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window and onboarding: all data commands (projects' documents included), settings, window controls, the storage retry, OS permissions, the agent CLI setup, the level meters, the microphone activity, the call in progress (call_*, discarded before «Удалить все данные» with call_discard), the recording's status (the call starts and stops it; recording_start and recording_stop are no window's), the call's questions and the agent's calls, the speech models, the hardware check and the mic check, the project brief (build, cancel, prepare, export), the open dialog (documents and the export folder), the OS name (the Windows variant of onboarding), and a finished call's records: its proposals and their review (proposals_*, proposal_decide, proposal_undo), its task cards (call_cards, call_card_update), its recordings with the transcript and its questions with their moments (call_transcript, call_questions), the search over the calls (calls_search).",
  "windows": ["main", "onboarding"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-unminimize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:default",
    "os:default",
    "dialog:allow-open",
    "allow-projects-list",
